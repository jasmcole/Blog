-down/268?cb=20210115124938 1x, https://static.wikia.nocookie.net/task/images/a/a8/The_last_supper..png/revision/latest/scale-to-width-down/536?cb=20210115124938 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"The last supper.\" width=\"270\" height=\"152\" data-image-key=\"The_last_supper..png\" data-image-name=\"The last supper..png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"series\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Series</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Series_1\" title=\"Series 1\">1</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"episode\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Episode</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">6</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"winner\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Winner</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Tim_Key\" title=\"Tim Key\">Tim Key</a></div>\n</div>\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Episode Guide</h2>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"previous\">← Previous</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next →</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"previous\"><a href=\"/wiki/Little_denim_shorts.\" title=\"Little denim shorts.\">Little denim shorts.</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\"><a href=\"/wiki/Fear_of_failure.\" title=\"Fear of failure.\">Fear of failure.</a></td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><i><b>The last supper.</b></i> is the sixth and final episode of <a href=\"/wiki/Series_1\" title=\"Series 1\">Series 1</a> of <i>Taskmaster</i> and was first broadcast on <a href=\"/wiki/Dave\" title=\"Dave\">Dave</a> on 1 September 2015. The episode was won by <a href=\"/wiki/Tim_Key\" title=\"Tim Key\">Tim Key</a>.\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Episode_title\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Episode title</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-2\"><a href=\"#Alternate_titles\"><span class=\"tocnumber\">1.1</span> <span class=\"toctext\">Alternate titles</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Episode_breakdown\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Episode breakdown</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Video\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Video</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#External_links\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">External links</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Episode_title\">Episode title</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Episode title\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_last_supper.?veaction=edit&amp;section=1\" aria-label=\"Edit section: Episode title\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>\"The last supper.\" is not a phrase uttered by anyone during this episode, but is instead a reference to the <a href=\"/wiki/Make_the_best_meal_for_the_Taskmaster_using_ingredients_beginning_with_every_letter_of_the_alphabet\" title=\"Make the best meal for the Taskmaster using ingredients beginning with every letter of the alphabet\">Make the best meal for the Taskmaster using ingredients beginning with every letter of the alphabet</a> task, possibly also alluding to the fact this was the final episode of the series. It is the only episode, to date, to not be named after a quote from someone within the episode, excluding paraphrases like <span style=\"font-family: Veteran Typewriter;\"><a href=\"/wiki/The_pie_whisperer.\" title=\"The pie whisperer.\">The pie whisperer.</a></span> or <span style=\"font-family: Veteran Typewriter;\"><a href=\"/wiki/Hippopotamus.\" title=\"Hippopotamus.\">Hippopotamus.</a></span>. The title card shows a broken egg shell in one of the holes from the <a href=\"/wiki/Get_the_lowest_golf_score_using_eggs\" title=\"Get the lowest golf score using eggs\">Get the lowest golf score using eggs</a> task.\n</p>\n<h3><span class=\"mw-headline\" id=\"Alternate_titles\">Alternate titles</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Alternate titles\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_last_supper.?veaction=edit&amp;section=2\" aria-label=\"Edit section: Alternate titles\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<ul><li>On Denmark's TV2 Play streaming platform, this episode is titled 'Den sidste nadver', which translates as 'The Last Supper'.</li>\n<li>On Finland's MTV Katsomo streaming platform, this episode is titled 'Viimeinen ehtoollinen', which translates as 'The Last Supper'.</li>\n<li>On Norway's Discovery+ Norge streaming platform, this episode is titled 'Det Siste Måltidet', which translates as 'The Last Supper'. Note: this Norwegian translation of the title only appears in the subtitles for the episode, whereas the episode title listed on the platform is the original English title.<div style=\"clear:both;\"></div></li></ul>\n<h2><span class=\"mw-headline\" id=\"Episode_breakdown\">Episode breakdown</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Episode breakdown\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_last_supper.?veaction=edit&amp;section=3\" aria-label=\"Edit section: Episode breakdown\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"mbox\"><div class=\"mbox&#95;&#95;content\"><div class=\"mbox&#95;&#95;content&#95;&#95;wrapper\"><div class=\"mbox&#95;&#95;content&#95;&#95;header\">Spoilers!</div><div class=\"mbox&#95;&#95;content&#95;&#95;text mw-collapsible\" id=\"mw-customcollapsible-spoilers\">This section contains spoilers.</div><span class=\"mbox&#95;&#95;close mw-customtoggle-spoilers\" title=\"Dismiss\"></span></div></div></div>\n<table class=\"tmtable\">\n\n<tbody><tr class=\"tmtableheader\">\n<th>Task\n</th>\n<th>Description\n</th>\n<th><a href=\"/wiki/Frank_Skinner\" title=\"Frank Skinner\"><span style=\"color:#FFF;\">Frank Skinner</span></a>\n</th>\n<th><a href=\"/wiki/Josh_Widdicombe\" title=\"Josh Widdicombe\"><span style=\"color:#FFF;\">Josh Widdicombe</span></a>\n</th>\n<th><a href=\"/wiki/Roisin_Conaty\" title=\"Roisin Conaty\"><span style=\"color:#FFF;\">Roisin Conaty</span></a>\n</th>\n<th><a href=\"/wiki/Romesh_Ranganathan\" title=\"Romesh Ranganathan\"><span style=\"color:#FFF;\">Romesh Ranganathan</span></a>\n</th>\n<th><a href=\"/wiki/Tim_Key\" title=\"Tim Key\"><span style=\"color:#FFF;\">Tim Key</span></a>\n</th></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Most_satisfying_item\" title=\"Most satisfying item\">1</a>\n</td>\n<td><b>Prize:</b> Most satisfying item.\n</td>\n<td>2\n</td>\n<td>4\n</td>\n<td>1\n</td>\n<td>3\n</td>\n<td><b>5</b>\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Get_the_lowest_golf_score_using_eggs\" title=\"Get the lowest golf score using eggs\">2</a>\n</td>\n<td>Get the lowest golf score using eggs. You must complete the 5 holes using chicken eggs. You score will be calculated as follows: Shots x eggs x minutes.\n</td>\n<td>4\n</td>\n<td>2\n</td>\n<td><b>5</b>\n</td>\n<td>1\n</td>\n<td>3\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Stage_a_realistic_blooper_from_a_home_movie\" title=\"Stage a realistic blooper from a home movie\">3</a>\n</td>\n<td><b>Team:</b> Stage a realistic blooper from a home movie.\n</td>\n<td><b>2</b>\n</td>\n<td>0\n</td>\n<td>0\n</td>\n<td>0\n</td>\n<td><b>2</b>\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Make_the_best_meal_for_the_Taskmaster_using_ingredients_beginning_with_every_letter_of_the_alphabet\" title=\"Make the best meal for the Taskmaster using ingredients beginning with every letter of the alphabet\">4</a>\n</td>\n<td>Make the best meal for the Taskmaster using ingredients beginning with every letter of the alphabet.\n</td>\n<td><b>5</b>\n</td>\n<td>1\n</td>\n<td>1\n</td>\n<td>4\n</td>\n<td>3\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Wearing_boxing_gloves,_put_the_blue_sweets_in_the_empty_bowl\" title=\"Wearing boxing gloves, put the blue sweets in the empty bowl\">5</a>\n</td>\n<td><b>Live:</b> Wearing boxing gloves, put the blue sweets in the empty bowl. Non-blue sweets will be subtracted from your total.\n</td>\n<td>3\n</td>\n<td>2\n</td>\n<td>1\n</td>\n<td>4\n</td>\n<td><b>5</b>\n</td></tr>\n<tr class=\"tmtabletotal\">\n<th colspan=\"2\">Total\n</th>\n<td>16\n</td>\n<td>9\n</td>\n<td>8\n</td>\n<td>12\n</td>\n<td class=\"tmtablewinner\">18\n</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Video\">Video</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Video\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_last_supper.?veaction=edit&amp;section=4\" aria-label=\"Edit section: Video\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><small><i>Video unavailable in some regions. Find an alternative service <a href=\"/wiki/Watch_Taskmaster\" title=\"Watch Taskmaster\">here</a>.</i></small>\n</p>\n<figure class=\"mw-halign-left\" typeof=\"mw:File\"> <a href=\"https://taskmaster.fandom.com/wiki/File:Taskmaster_-_Series_1,_Episode_6_%27The_last_supper%27\" class=\"video video-thumbnail medium \"> \t<img src=\"https://static.wikia.nocookie.net/task/images/7/77/Taskmaster_-_Series_1%2C_Episode_6_%27The_last_supper%27/revision/latest/scale-to-width-down/350?cb=20210130003846\" alt=\"Taskmaster_-_Series_1,_Episode_6_&#39;The_last_supper&#39;\" height=\"263\" width=\"350\" data-video-key=\"Taskmaster_-_Series_1,_Episode_6_&#39;The_last_supper&#39;\" data-video-name=\"Taskmaster - Series 1, Episode 6 &#39;The last supper&#39;\" class=\"\" /> \t<span class=\"thumbnail-play-icon-container\"> \t\t<svg class=\"thumbnail-play-icon wds-icon\" aria-label=\"Play\"><use xlink:href=\"#wds-player-icon-play\"></use></svg>\t</span> </a> <figcaption></figcaption></figure><div style=\"clear:both;\"></div>\n<h2><span class=\"mw-headline\" id=\"External_links\">External links</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: External links\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_last_supper.?veaction=edit&amp;section=5\" aria-label=\"Edit section: External links\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li><a target=\"_blank\" rel=\"nofollow noreferrer noopener\" class=\"external text\" href=\"https://taskmaster.tv/shows/last-supper\"><i>The last supper.</i> on Taskmaster website</a></li>\n<li><a target=\"_blank\" rel=\"nofollow noreferrer noopener\" class=\"external text\" href=\"https://www.channel4.com/programmes/taskmaster/on-demand/71670-006\"><i>The last supper.</i> on All 4</a></li>\n<li><a target=\"_blank\" rel=\"nofollow noreferrer noopener\" class=\"external text\" href=\"https://taskmastersupermaxplus.vhx.tv/videos/episode-6-the-last-supper\"><i>The last supper.</i> on Supermax+</a></li></ul>\n<!-- \nNewPP limit report\nCached time: 20260920141442\nCache expiry: 2592000\nReduced expiry: false\nComplications: [show‐toc]\nCPU time usage: 0.074 seconds\nReal time usage: 0.120 seconds\nPreprocessor visited node count: 423/1000000\nPost‐expand include size: 24568/2097152 bytes\nTemplate argument size: 166/2097152 bytes\nHighest expansion depth: 8/100\nExpensive parser function