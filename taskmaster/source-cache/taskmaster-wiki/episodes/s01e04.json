n/268?cb=20210115124853 1x, https://static.wikia.nocookie.net/task/images/d/d5/Down_an_octave..png/revision/latest/scale-to-width-down/536?cb=20210115124853 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"Down an octave.\" width=\"270\" height=\"152\" data-image-key=\"Down_an_octave..png\" data-image-name=\"Down an octave..png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"series\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Series</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Series_1\" title=\"Series 1\">1</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"episode\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Episode</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">4</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"winner\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Winner</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Josh_Widdicombe\" title=\"Josh Widdicombe\">Josh Widdicombe</a></div>\n</div>\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Episode Guide</h2>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"previous\">← Previous</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next →</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"previous\"><a href=\"/wiki/The_poet_and_the_egg.\" title=\"The poet and the egg.\">The poet and the egg.</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\"><a href=\"/wiki/Little_denim_shorts.\" title=\"Little denim shorts.\">Little denim shorts.</a></td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><i><b>Down an octave.</b></i> is the fourth episode of <a href=\"/wiki/Series_1\" title=\"Series 1\">Series 1</a> of <i>Taskmaster</i> and was first broadcast on <a href=\"/wiki/Dave\" title=\"Dave\">Dave</a> on 18 August 2015. The episode was won by <a href=\"/wiki/Josh_Widdicombe\" title=\"Josh Widdicombe\">Josh Widdicombe</a>.\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Episode_title\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Episode title</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-2\"><a href=\"#Alternate_Titles\"><span class=\"tocnumber\">1.1</span> <span class=\"toctext\">Alternate Titles</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Episode_breakdown\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Episode breakdown</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Video\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Video</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#External_links\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">External links</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Episode_title\">Episode title</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Episode title\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/Down_an_octave.?veaction=edit&amp;section=1\" aria-label=\"Edit section: Episode title\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>\"Down an octave\" was <a href=\"/wiki/Roisin_Conaty\" title=\"Roisin Conaty\">Roisin Conaty</a>'s response to <a href=\"/wiki/Josh_Widdicombe\" title=\"Josh Widdicombe\">Josh Widdicombe</a>'s high-pitched reaction to her receiving assistance from Alex during the <a href=\"/wiki/Make_this_ice_block_disappear_as_fast_as_possible\" title=\"Make this ice block disappear as fast as possible\">Make this ice block disappear as fast as possible</a> task. The title card shows the shattered plant pot from Widdicombe, Conaty, and <a href=\"/wiki/Romesh_Ranganathan\" title=\"Romesh Ranganathan\">Ranganathan</a>'s attempt at the <a href=\"/wiki/Get_to_11_points_as_fast_as_possible\" title=\"Get to 11 points as fast as possible\">Get to 11 points as fast as possible</a> task.\n</p>\n<h3><span class=\"mw-headline\" id=\"Alternate_Titles\">Alternate Titles</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Alternate Titles\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/Down_an_octave.?veaction=edit&amp;section=2\" aria-label=\"Edit section: Alternate Titles\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<ul><li>On Denmark's TV2 Play streaming platform, this episode is titled 'En oktav ned', which translates as 'One octave down'.</li>\n<li>On Finland's MTV Katsomo streaming platform, this episode is titled 'Älä kimitä', which translates as 'Don't whine'.</li>\n<li>On Norway's Discovery+ Norge streaming platform, this episode is titled 'Ned en Oktav', which translates as 'Down an octave'. Note: this Norwegian translation of the title only appears in the subtitles for the episode, whereas the episode title listed on the platform is the original English title.<div style=\"clear:both;\"></div></li></ul>\n<h2><span class=\"mw-headline\" id=\"Episode_breakdown\">Episode breakdown</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Episode breakdown\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/Down_an_octave.?veaction=edit&amp;section=3\" aria-label=\"Edit section: Episode breakdown\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"mbox\"><div class=\"mbox&#95;&#95;content\"><div class=\"mbox&#95;&#95;content&#95;&#95;wrapper\"><div class=\"mbox&#95;&#95;content&#95;&#95;header\">Spoilers!</div><div class=\"mbox&#95;&#95;content&#95;&#95;text mw-collapsible\" id=\"mw-customcollapsible-spoilers\">This section contains spoilers.</div><span class=\"mbox&#95;&#95;close mw-customtoggle-spoilers\" title=\"Dismiss\"></span></div></div></div>\n<table class=\"tmtable\">\n\n<tbody><tr class=\"tmtableheader\">\n<th>Task\n</th>\n<th>Description\n</th>\n<th><a href=\"/wiki/Frank_Skinner\" title=\"Frank Skinner\"><span style=\"color:#FFF;\">Frank Skinner</span></a>\n</th>\n<th><a href=\"/wiki/Josh_Widdicombe\" title=\"Josh Widdicombe\"><span style=\"color:#FFF;\">Josh Widdicombe</span></a>\n</th>\n<th><a href=\"/wiki/Roisin_Conaty\" title=\"Roisin Conaty\"><span style=\"color:#FFF;\">Roisin Conaty</span></a>\n</th>\n<th><a href=\"/wiki/Romesh_Ranganathan\" title=\"Romesh Ranganathan\"><span style=\"color:#FFF;\">Romesh Ranganathan</span></a>\n</th>\n<th><a href=\"/wiki/Tim_Key\" title=\"Tim Key\"><span style=\"color:#FFF;\">Tim Key</span></a>\n</th></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Most_beautiful_item\" title=\"Most beautiful item\">1</a>\n</td>\n<td><b>Prize:</b> Most beautiful item.\n</td>\n<td>3\n</td>\n<td>4\n</td>\n<td>2\n</td>\n<td>1\n</td>\n<td><b>5</b>\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Make_this_ice_block_disappear_as_fast_as_possible\" title=\"Make this ice block disappear as fast as possible\">2</a>\n</td>\n<td>Make this ice block disappear as fast as possible.\n</td>\n<td>4\n</td>\n<td><b>5</b>\n</td>\n<td>3\n</td>\n<td>2\n</td>\n<td>1\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Get_to_11_points_as_fast_as_possible\" title=\"Get to 11 points as fast as possible\">3</a>\n</td>\n<td><b>Team:</b> Get to 11 points as fast as possible.\n</td>\n<td>1\n</td>\n<td><b>2</b>\n</td>\n<td><b>2</b>\n</td>\n<td><b>2</b>\n</td>\n<td>1\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Fill_an_egg_cup_with_as_many_tears_as_possible\" title=\"Fill an egg cup with as many tears as possible\">4</a>\n</td>\n<td>Fill an egg cup with as many tears as possible.\n</td>\n<td><b>5</b>\n</td>\n<td>3\n</td>\n<td>1\n</td>\n<td>4\n</td>\n<td>1\n</td></tr>\n<tr class=\"tmtablerow\">\n<td rowspan=\"3\"><a href=\"/wiki/Count_the_beans_in_the_baked_bean_tin\" title=\"Count the beans in the baked bean tin\">S</a>\n</td>\n<td>Count the beans in this baked bean tin.\n</td>\n<td rowspan=\"3\">–\n</td>\n<td rowspan=\"3\"><b>1</b>\n</td>\n<td rowspan=\"3\">–\n</td>\n<td rowspan=\"3\">–\n</td>\n<td rowspan=\"3\">–\n</td></tr>\n<tr class=\"tmtablerow\">\n<td>Count the hoops in this tin of spaghetti hoops\n</td></tr>\n<tr class=\"tmtablerow\">\n<td>Count the grains of rice i