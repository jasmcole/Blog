atest/scale-to-width-down/268?cb=20210115124833 1x, https://static.wikia.nocookie.net/task/images/1/1b/The_poet_and_the_egg..png/revision/latest/scale-to-width-down/536?cb=20210115124833 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"The poet and the egg.\" width=\"270\" height=\"152\" data-image-key=\"The_poet_and_the_egg..png\" data-image-name=\"The poet and the egg..png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"series\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Series</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Series_1\" title=\"Series 1\">1</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"episode\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Episode</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">3</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"winner\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Winner</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Josh_Widdicombe\" title=\"Josh Widdicombe\">Josh Widdicombe</a></div>\n</div>\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Episode Guide</h2>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"previous\">← Previous</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next →</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"previous\"><a href=\"/wiki/The_pie_whisperer.\" title=\"The pie whisperer.\">The pie whisperer.</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\"><a href=\"/wiki/Down_an_octave.\" title=\"Down an octave.\">Down an octave.</a></td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><i><b>The poet and the egg.</b></i> is the third episode of <a href=\"/wiki/Series_1\" title=\"Series 1\">Series 1</a> of <i>Taskmaster</i> and was first broadcast on <a href=\"/wiki/Dave\" title=\"Dave\">Dave</a> on 11 August 2015. The episode was won by <a href=\"/wiki/Josh_Widdicombe\" title=\"Josh Widdicombe\">Josh Widdicombe</a>.\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Episode_title\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Episode title</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-2\"><a href=\"#Alternate_titles\"><span class=\"tocnumber\">1.1</span> <span class=\"toctext\">Alternate titles</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Episode_breakdown\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Episode breakdown</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Video\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Video</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#External_links\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">External links</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Episode_title\">Episode title</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Episode title\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_poet_and_the_egg.?veaction=edit&amp;section=1\" aria-label=\"Edit section: Episode title\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>\"The poet and the egg\" was how <a href=\"/wiki/Greg_Davies\" title=\"Greg Davies\">Greg Davies</a> introduced <a href=\"/wiki/Tim_Key\" title=\"Tim Key\">Tim Key</a>'s attempt at the <a href=\"/wiki/Get_this_egg_as_high_as_possible\" title=\"Get this egg as high as possible\">Get this egg as high as possible</a> task. The title card is a broken egg, taken from the same task.\n</p>\n<h3><span class=\"mw-headline\" id=\"Alternate_titles\">Alternate titles</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Alternate titles\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_poet_and_the_egg.?veaction=edit&amp;section=2\" aria-label=\"Edit section: Alternate titles\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<ul><li>On Denmark's TV2 Play streaming platform, this episode is titled 'Digteren og ægget', which translates as 'The poet and the egg'.</li>\n<li>On Finland's MTV Katsomo streaming platform, this episode is titled 'Runoilija ja kananmuna', which translates as 'The poet and the egg'.</li>\n<li>On Norway's Discovery+ Norge streaming platform, this episode is titled 'Poeten og Egget', which translates as 'The poet and the egg'. Note: this Norwegian translation of the title only appears in the subtitles for the episode, whereas the episode title listed on the platform is the original English title.<div style=\"clear:both;\"></div></li></ul>\n<h2><span class=\"mw-headline\" id=\"Episode_breakdown\">Episode breakdown</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Episode breakdown\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_poet_and_the_egg.?veaction=edit&amp;section=3\" aria-label=\"Edit section: Episode breakdown\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"mbox\"><div class=\"mbox&#95;&#95;content\"><div class=\"mbox&#95;&#95;content&#95;&#95;wrapper\"><div class=\"mbox&#95;&#95;content&#95;&#95;header\">Spoilers!</div><div class=\"mbox&#95;&#95;content&#95;&#95;text mw-collapsible\" id=\"mw-customcollapsible-spoilers\">This section contains spoilers.</div><span class=\"mbox&#95;&#95;close mw-customtoggle-spoilers\" title=\"Dismiss\"></span></div></div></div>\n<table class=\"tmtable\">\n\n<tbody><tr class=\"tmtableheader\">\n<th>Task\n</th>\n<th>Description\n</th>\n<th><a href=\"/wiki/Frank_Skinner\" title=\"Frank Skinner\"><span style=\"color:#FFF;\">Frank Skinner</span></a>\n</th>\n<th><a href=\"/wiki/Josh_Widdicombe\" title=\"Josh Widdicombe\"><span style=\"color:#FFF;\">Josh Widdicombe</span></a>\n</th>\n<th><a href=\"/wiki/Roisin_Conaty\" title=\"Roisin Conaty\"><span style=\"color:#FFF;\">Roisin Conaty</span></a>\n</th>\n<th><a href=\"/wiki/Romesh_Ranganathan\" title=\"Romesh Ranganathan\"><span style=\"color:#FFF;\">Romesh Ranganathan</span></a>\n</th>\n<th><a href=\"/wiki/Tim_Key\" title=\"Tim Key\"><span style=\"color:#FFF;\">Tim Key</span></a>\n</th></tr