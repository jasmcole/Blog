to-width-down/268?cb=20210115124607 1x, https://static.wikia.nocookie.net/task/images/c/cb/The_pie_whisperer..png/revision/latest/scale-to-width-down/536?cb=20210115124607 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"The pie whisperer.\" width=\"270\" height=\"152\" data-image-key=\"The_pie_whisperer..png\" data-image-name=\"The pie whisperer..png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"series\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Series</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Series_1\" title=\"Series 1\">1</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"episode\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Episode</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">2</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"winner\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Winner</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Roisin_Conaty\" title=\"Roisin Conaty\">Roisin Conaty</a></div>\n</div>\n<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Episode Guide</h2>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"previous\">← Previous</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next →</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"previous\"><a href=\"/wiki/Melon_buffet.\" title=\"Melon buffet.\">Melon buffet.</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\"><a href=\"/wiki/The_poet_and_the_egg.\" title=\"The poet and the egg.\">The poet and the egg.</a></td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><i><b>The pie whisperer.</b></i> is the second episode of <a href=\"/wiki/Series_1\" title=\"Series 1\">Series 1</a> of <i>Taskmaster</i> and was first broadcast on <a href=\"/wiki/Dave\" title=\"Dave\">Dave</a> on 4 August 2015. The episode was won by <a href=\"/wiki/Roisin_Conaty\" title=\"Roisin Conaty\">Roisin Conaty</a>.\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Episode_title\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Episode title</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-2\"><a href=\"#Alternate_titles\"><span class=\"tocnumber\">1.1</span> <span class=\"toctext\">Alternate titles</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Episode_breakdown\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Episode breakdown</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Video\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Video</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#External_links\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">External links</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Episode_title\">Episode title</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Episode title\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_pie_whisperer.?veaction=edit&amp;section=1\" aria-label=\"Edit section: Episode title\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>\"Some kind of pie whisperer\" was how <a href=\"/wiki/Greg_Davies\" title=\"Greg Davies\">Greg Davies</a> characterised <a href=\"/wiki/Frank_Skinner\" title=\"Frank Skinner\">Frank Skinner</a> during the <a href=\"/wiki/Identify_the_contents_of_these_pies\" title=\"Identify the contents of these pies\">Identify the contents of these pies</a> task. The title card is a tree, referencing <a href=\"/wiki/Romesh_Ranganathan\" title=\"Romesh Ranganathan\">Romesh Ranganathan</a>'s \"tree wizard\" video from the <a href=\"/wiki/Do_something_that_will_look_impressive_in_reverse\" title=\"Do something that will look impressive in reverse\">Do something that will look impressive in reverse</a> task.\n</p>\n<h3><span class=\"mw-headline\" id=\"Alternate_titles\">Alternate titles</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Alternate titles\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_pie_whisperer.?veaction=edit&amp;section=2\" aria-label=\"Edit section: Alternate titles\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<ul><li>On Denmark's TV2 Play streaming platform, this episode is titled 'Tærtehviskeren', which translates as 'The pie whisperer'.</li>\n<li>On Finland's MTV Katsomo streaming platform, this episode is titled 'Piiraskuiskaaja', which translates as 'The pie whisperer'.</li>\n<li>On Norway's Discovery+ Norge streaming platform, this episode is titled 'Paihviskeren', which translates as 'The pie whisperer'. Note: this Norwegian translation of the title only appears in the subtitles for the episode, whereas the episode title listed on the platform is the original English title.<div style=\"clear:both;\"></div></li></ul>\n<h2><span class=\"mw-headline\" id=\"Episode_breakdown\">Episode breakdown</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Episode breakdown\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_pie_whisperer.?veaction=edit&amp;section=3\" aria-label=\"Edit section: Episode breakdown\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"mbox\"><div class=\"mbox&#95;&#95;content\"><div class=\"mbox&#95;&#95;content&#95;&#95;wrapper\"><div class=\"mbox&#95;&#95;content&#95;&#95;header\">Spoilers!</div><div class=\"mbox&#95;&#95;content&#95;&#95;text mw-collapsible\" id=\"mw-customcollapsible-spoilers\">This section contains spoilers.</div><span class=\"mbox&#95;&#95;close mw-customtoggle-spoilers\" title=\"Dismiss\"></span></div></div></div>\n<table class=\"tmtable\">\n\n<tbody><tr class=\"tmtableheader\">\n<th>Task\n</th>\n<th>Description\n</th>\n<th><a href=\"/wiki/Frank_Skinner\" title=\"Frank Skinner\"><span style=\"color:#FFF;\">Frank Skinner</span></a>\n</th>\n<th><a href=\"/wiki/Josh_Widdicombe\" title=\"Josh Widdicombe\"><span style=\"color:#FFF;\">Josh Widdicombe</span></a>\n</th>\n<th><a href=\"/wiki/Roisin_Conaty\" title=\"Roisin Conaty\"><span style=\"color:#FFF;\">Roisin Conaty</span></a>\n</th>\n<th><a href=\"/wiki/Romesh_Ranganathan\" title=\"Romesh Ranganathan\"><span style=\"color:#FFF;\">Romesh Ranganathan</span></a>\n</th>\n<th><a href=\"/wiki/Tim_Key\" title=\"Tim Key\"><span style=\"color:#FFF;\">Tim Key</span></a>\n</th></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Most_impressive_item\" title=\"Most impressive item\">1</a>\n</td>\n<td><b>Prize:</b> Most impressive item.\n</td>\n<td>4\n</td>\n<td>2\n</td>\n<td>3\n</td>\n<td>1\n</td>\n<td><b>5</b>\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/High-five_a_55_year-old\" title=\"High-five a 55 year-old\">2</a>\n</td>\n<td>High-five a 55-year-old.\n</td>\n<td>2\n</td>\n<td><b>5</b>\n</td>\n<td>4\n</td>\n<td>1\n</td>\n<td>3\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Identify_the_contents_of_these_pies\" title=\"Identify the contents of these pies\">3</a>\n</td>\n<td>Identify the contents of these pies. You may touch the pies, but may not breach their pastry.\n</td>\n<td>1\n</td>\n<td>2\n</td>\n<td>4\n</td>\n<td>3\n</td>\n<td><b>5</b>\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Do_something_that_will_look_impressive_in_reverse\" title=\"Do something that will look impressive in reverse\">4</a>\n</td>\n<td>Do something that will look impressive in reverse. The Taskmaster will see whatever act you perform played backwards. You must therefore do something backwards that will look impressive when the footage is played in reverse.\n</td>\n<td>1\n</td>\n<td>4\n</td>\n<td><b>5</b>\n</td>\n<td><b>5</b>\n</td>\n<td>3\n</td></tr>\n<tr class=\"tmtablerow\">\n<td><a href=\"/wiki/Crack_the_code,_unshackle_yourself_and_sprint_1_metre\" title=\"Crack the code, unshackle yourself and sprint 1 metre\">5</a>\n</td>\n<td><b>Live:</b> Crack the code, unshackle yourself and sprint 1 metre.\n</td>\n<td>1\n</td>\n<td>3\n</td>\n<td><b>5</b>\n</td>\n<td>4\n</td>\n<td>2\n</td></tr>\n<tr class=\"tmtabletotal\">\n<th colspan=\"2\">Total\n</th>\n<td>9\n</td>\n<td>16\n</td>\n<td class=\"tmtablewinner\">21\n</td>\n<td>14\n</td>\n<td>18\n</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Video\">Video</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: Video\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"edit-section-anon\" data-action=\"edit-section\" href=\"https://taskmaster.fandom.com/wiki/The_pie_whisperer.?veaction=edit&amp;section=4\" aria-label=\"Edit section: Video\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><small><i>Video unavailable in some regions. Find an alternative service <a href=\"/wiki/Watch_Taskmaster\" title=\"Watch Taskmaster\">here</a>.</i></small>\n</p>\n<figure class=\"mw-halign-left\" typeof=\"mw:File\"> <a href=\"https://taskmaster.fandom.com/wiki/File:Taskmaster_-_Series_1,_Episode_2_%27The_pie_whisperer%27\" class=\"video video-thumbnail medium \"> \t<img src=\"https://static.wikia.nocookie.net/task/images/d/db/Taskmaster_-_Series_1%2C_Episode_2_%27The_pie_whisperer%27/revision/latest/scale-to-width-down/350?cb=20210130003842\" alt=\"Taskmaster_-_Series_1,_Episode_2_&#39;The_pie_whisperer&#39;\" height=\"263\" width=\"350\" data-video-key=\"Taskmaster_-_Series_1,_Episode_2_&#39;The_pie_whisperer&#39;\" data-video-name=\"Taskmaster - Series 1, Episode 2 &#39;The pie whisperer&#39;\" class=\"\" /> \t<span class=\"thumbnail-play-icon-container\"> \t\t<svg class=\"thumbnail-play-icon wds-icon\" aria-label=\"Play\"><use xlink:href=\"#wds-player-icon-play\"></use></svg>\t</span> </a> <figcaption></figcaption></figure><div style=\"clear:both;\"></div>\n<h2><span class=\"mw-headline\" id=\"External_links\">External links</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Edit section: External links\" class=\"mw-editsection-vis